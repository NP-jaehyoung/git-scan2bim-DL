      "Code": "# Python 표준 및 DesignScript 라이브러리 로드\r\nimport sys\r\nimport clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import PolyCurve, Point\r\n\r\n# 예: x_coords = [1,2,3], y_coords = [4,5,6], z_coords = [7,8,9]\r\nx_coords = IN[0]\r\ny_coords = IN[1]\r\nz_coords = IN[2]\r\n\r\n\r\n# pointsList가 None이면(값이 없으면) 에러 처리\r\nif x_coords is None:\r\n    OUT = \"pointsList is None. Check CSV path or function output!\"\r\nelse:\r\n    # 각 좌표를 Point로 바꾼 뒤, PolyCurve 생성\r\n    polyCurves = []\r\n    for i in range(len(x_coords)):\r\n        x = x_coords[i]\r\n        y = y_coords[i]\r\n        z = z_coords[i]\r\n        p = Point.ByCoordinates(x, y, z)\r\n        points.append(p)\r\n\r\n        # 점들을 연결해 폐합 PolyCurve(사각형 등)를 만든다\r\n        polyCurve = PolyCurve.ByPoints(polyCurves, True)\r\n        OUT = polyCurve",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "258b08ac6fcb4129ab8d4d2d848086d8",
      "Inputs": [
        {
          "Id": "0eed57e63c3348f1b0cc6b933eabd6fb",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
